@startuml PasswordSecurity
title ZTF_J2EE - Fluxo Criptográfico de Senhas (BCrypt + Salt + Pepper)

start

:Usuário digita a senha em texto plano;

partition "Camada 1: Proteção Pepper (javax.crypto.Mac HmacSHA256)" {
  :Obtém 'security.password_pepper' do WEB-INF/etc/config.json;
  :Executa Mac.getInstance("HmacSHA256") gerando 64 caracteres hexadecimais;
  note right
    - Remove limite de 72 bytes do BCrypt
    - Impede quebra de hash mesmo se o dump do banco vazar
  end note
}

partition "Camada 2: Proteção Salt + BCrypt (utils.BCrypt)" {
  :Gera Salt criptográfico aleatório único de 16 bytes (SecureRandom);
  :Aplica algoritmo Blowfish BCrypt com 'bcrypt_cost' (12);
  :Gera hash final de 60 caracteres ($2y$12$...);
}

:Armazena Hash Final na tabela 'usuarios' via PreparedStatement;

stop
@enduml
