@startuml Session_ACL
title Sequência de Autenticação, Sessão e Guarda ACL (Fase 4)

actor "Usuário" as User
participant "login.jsp / home.jsp" as View
participant "AuthController" as Auth
participant "RateLimiter\n(por IP)" as Limiter
participant "Usuario\n(Model)" as Model
participant "SegurancaLogin" as Seg
participant "Auditoria" as Aud
database "MySQL" as DB
entity "HttpSession" as Session
participant "SessaoFilter" as Filtro
participant "Router" as Router

User -> View : GET /login
View -> Session : Csrf.token() (sessão anônima)
View --> User : formulário + token CSRF

User -> Auth : POST /login { email, senha, _csrf }
note over Router : Router confere o token CSRF antes da ação\n(sem token: 403 ERR_CSRF)
Auth -> Limiter : tryAcquire(ip)
alt muitas tentativas do mesmo IP
    Auth --> User : 429
else
    Auth -> Model : autenticarDetalhado(email, senha)
    Model -> DB : SELECT id_usuario, senha_hash, status\nWHERE email = ? (PreparedStatement)
    alt e-mail não cadastrado
        Model -> Model : verify() contra hash fictício\n(tempo de resposta igual)
        Model --> Auth : CREDENCIAIS_INVALIDAS
    else bloqueado (usuarios_seguranca.bloqueado_ate > NOW())
        Model -> Seg : estaBloqueado(id)
        Model --> Auth : BLOQUEADO
    else senha errada ou usuário inativo
        Model --> Auth : CREDENCIAIS_INVALIDAS (id)
        Auth -> Seg : registrarFalha(id)\n(5ª falha: bloqueia por 15 min)
    else senha correta
        Model -> DB : grupos, permissões, primeiro_acesso
        Model --> Auth : SUCESSO + dados da sessão (acl_versao)
    end

    alt não autenticado
        Auth -> Aud : login.falha / login.bloqueado
        Auth --> User : 401 mensagem única\n(não revela qual foi o motivo)
    else autenticado
        Auth -> Seg : registrarSucesso(id) (zera falhas)
        Auth -> Session : invalidate() + nova sessão (anti Session Fixation)
        Auth -> Session : setAttribute("user", dados)\nsetMaxInactiveInterval(1800 s)\nCsrf.rotate()
        Auth -> Aud : login.sucesso
        Auth --> User : 200 { redirect: painel do perfil\nou "trocar-senha" no primeiro acesso }
    end
end

== Requisições seguintes ==

User -> Filtro : qualquer requisição
Filtro -> Session : acl_versao da sessão == versão atual?
alt admin alterou grupos/permissões/status
    Filtro -> Model : carregarSessao(id)
    alt usuário inativo ou removido
        Filtro -> Session : invalidate()
    else
        Filtro -> Session : grupos/permissões atualizados
    end
end
Filtro -> Router : segue para o Controller / JSP
Router -> Session : sessão, primeiro acesso, grupos e permissões da rota
alt autorizado
    Router --> User : executa a ação
else
    Router --> User : 401 / 403 / redireciona para /trocar-senha
end
@enduml
