@startuml Atividades_Atendimento
title Atividades do Encounter (do agendamento à receita)

|Recepcionista|
start
:Buscar paciente por nome ou CPF;
if (Paciente cadastrado?) then (não)
  :Cadastrar paciente\n(CPF válido e único);
endif
if (Tem agendamento?) then (sim)
  :Localizar consulta na agenda do dia;
  :Registrar chegada;
else (não - encaixe)
  :Criar consulta de encaixe\njá com chegada registrada;
endif
note right: consulta = aguardando_triagem

|Enfermeiro|
:Escolher paciente na fila de triagem;
:Iniciar triagem;
repeat
  :Registrar sinais vitais, queixa e sintomas;
repeat while (Valores dentro das faixas?) is (não - corrigir)
->sim;
:Escolher classificação de prioridade\n(vermelho, laranja, amarelo, verde, azul);
:Encaminhar ao atendimento médico;
note right: consulta = aguardando_atendimento

|Médico|
:Chamar próximo da fila\n(prioridade, depois chegada);
:Iniciar atendimento;
note right: prontuário criado como rascunho
:Consultar triagem, alergias e histórico;
:Registrar anamnese, hipóteses e conduta;
if (Precisa de receita?) then (sim)
  :Emitir receita com itens;
  :Imprimir receita (nome e CRM/UF);
endif
if (Precisa de exames?) then (sim)
  :Solicitar exames;
endif
:Finalizar atendimento;
note right
  prontuário finalizado (imutável)
  consulta = realizada
end note

|Sistema|
:Registrar auditoria das ações clínicas;
stop
@enduml
