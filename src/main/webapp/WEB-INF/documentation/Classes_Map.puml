@startuml Classes_Map
title ZTF_J2EE - Mapa de Classes por Pacote (framework + dominio hospitalar)

skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam roundcorner 8

package "javax.servlet.http" #F1F5F9 {
    abstract class HttpServlet {
        # service(HttpServletRequest req, HttpServletResponse res): void
    }
}

package "database" #EEF6FF {
    class DBConnection {
        - {static} Map<String, Connection> INSTANCES
        + {static} getStaticConnection(): Connection
        + {static} getStaticConnection(String name): Connection
        + {static} openConnection(): Connection
        + {static} setConnection(String name, Connection conn): void
        + {static} closeAll(): void
    }
    class Migracoes {
        + {static} aplicarPendentes(Connection conn): Resultado
    }
    class DatabaseProvisioner {
        + {static} REQUIRED_TABLES: List<String>
        + {static} checkAndProvision(): Map<String, Object>
        + {static} ensureProvisioned(): Map<String, Object>
        + {static} resetState(): void
    }
    class Sql <<helper JDBC>> {
        + {static} lista(String sql, Object... p): List<Map>
        + {static} um(String sql, Object... p): Map
        + {static} numero(String sql, Object... p): long
        + {static} executar(Connection c, String sql, Object... p): int
        + {static} inserir(Connection c, String sql, Object... p): long
        + {static} ehDuplicidade(SQLException e): boolean
    }
    class DBQuery {
        + DBQuery(String table, String fields, Connection db)
        + addCondition(String logical, String col, String op, Object val): DBQuery
        + addIn(String logical, String col, Collection<?> values): DBQuery
        + addJoin(String type, String table, String k1, String op, String ft, String k2): DBQuery
        + joinRaw(String rawJoin): DBQuery
        + orderBy(String col, String dir): DBQuery
        + limit(int limit, int offset): DBQuery
        + select(): List<Map<String, Object>>
        + first(): Map<String, Object>
        + insert(Map<String, Object> data): long
        + update(Map<String, Object> data): int
        + delete(): int
    }
}

package "utils" #F4FBF7 {
    class Config {
        + {static} bindServletContext(ServletContext ctx): void
        + {static} readResourceText(String relPath): String
        + {static} get(String key, Object defaultVal): Object
        + {static} getString(String key, String defaultVal): String
        + {static} getInt(String key, int defaultVal): int
        + {static} getBoolean(String key, boolean defaultVal): boolean
        + {static} has(String key): boolean
        + {static} set(String key, Object value): void
        + {static} reload(): void
    }
    class Url {
        + {static} bindRequest(HttpServletRequest req): void
        + {static} base(HttpServletRequest req): String
        + {static} rootPath(HttpServletRequest req): String
        + {static} to(HttpServletRequest req, String path): String
        + {static} full(HttpServletRequest req, String path): String
        + {static} asset(HttpServletRequest req, String assetPath): String
        + {static} redirect(HttpServletRequest req, HttpServletResponse res, String path): void
    }
    class Router {
        + Router(String routesFilePath, String basePath)
        + {static} checkJspAccess(HttpServletRequest req, HttpServletResponse res): boolean
        + dispatch(HttpServletRequest req, HttpServletResponse res, Object targetCtrl): Object
        + checkAccessControl(Map routeCfg, Map userSession): Map<String, Object>
        + matchRoute(String uri): RouteMatch
        + addRoute(String uri, String method, Map config): void
    }
    class RequestHelper {
        + {static} getRequestPayload(HttpServletRequest req): Map<String, Object>
        + {static} getSessionUser(HttpServletRequest req): Map<String, Object>
        + {static} getRouteParams(HttpServletRequest req): Map<String, String>
    }
    class Sanitize {
        + {static} string(Object value): String
        + {static} email(Object value): String
        + {static} intVal(Object value, int defaultVal): int
        + {static} floatVal(Object value, double defaultVal): double
        + {static} alphaNum(Object value): String
        + {static} escapeHtml(Object value): String
    }
    class JsonResponse {
        + {static} send(HttpServletResponse res, boolean status, int code, String msg, Object data, String err): String
        + {static} success(HttpServletResponse res, Object data, String msg, int code): String
        + {static} error(HttpServletResponse res, int code, String err, String msg, Object details): String
    }
    class PasswordSecurity {
        + {static} hash(String plainPassword): String
        + {static} verify(String plainPassword, String hashedPassword): boolean
        + {static} needsRehash(String hashedPassword): boolean
        + {static} strengthError(String password): String
        + {static} sha256Hex(String data): String
    }
    class RateLimiter {
        + RateLimiter(int maxAttempts, long windowMillis)
        + tryAcquire(String key): boolean
        + reset(String key): void
    }
    class BCrypt {
        + {static} hashpw(String password, String salt): String
        + {static} gensalt(int logRounds): String
        + {static} checkpw(String plaintext, String hashed): boolean
    }
    class CodeGenerator {
        + {static} generatePassword(int length): String
        + {static} generateNumericCode(int digits): String
        + {static} generateToken(int bytes): String
    }
    class Csrf {
        + {static} token(HttpServletRequest req): String
        + {static} rotate(HttpSession s): String
        + {static} metaTag(HttpServletRequest req): String
        + {static} isValid(HttpServletRequest req): boolean
    }
    class SecurityHeadersFilter <<WebFilter>> {
        + doFilter(req, res, chain): void
    }
    class Menu {
        + {static} visiveis(List<String> permissoes): Map<String, List<Item>>
        + {static} atalhos(List<String> permissoes): List<Item>
        + {static} perfilPrincipal(List<String> grupos): String
    }
    class Validacao {
        + {static} cpfValido(String cpf): boolean
        + {static} cpfMascarado(String cpf): String
        + {static} emailValido(String email): boolean
        + {static} telefoneValido(String tel): boolean
        + {static} ufValida(String uf): boolean
        + {static} data(String valor): LocalDate
    }
    class Rotulos {
        + {static} pilulaConsulta(Object status): String
        + {static} pilulaExame(Object status): String
        + {static} dataHora(Object v): String
        + {static} diaDaSemana(Object dia): String
    }
    class Base64Files {
        + {static} fileToBase64(String filePath, boolean withMimePrefix): String
        + {static} base64ToFile(String base64String, String outputPath): int
        + {static} extractMimeType(String base64DataUri): String
        + {static} isSafeImageDataUri(String dataUri, int maxBytes): boolean
    }
}

package "mail" #F0FDFA {
    class Mail {
        + setRecipient(String email, String name): Mail
        + setSubject(String subject): Mail
        + setBody(String htmlBody): Mail
        + send(): boolean
        + {static} quickSend(String to, String toName, String subject, String html): boolean
    }
    class Sms {
        + {static} send(String to, String message): boolean
    }
}

package "models" #FFF9EB {
    class Usuario {
        + autenticar(String email, String senhaPlana): Map<String, Object>
        + autenticarDetalhado(String email, String senha): ResultadoLogin
        + carregarSessao(int idUsr): Map<String, Object>
        + alterarSenha(int idUsr, String atual, String nova): String
        + {static} versaoAcl(): long
        + {static} invalidarAcl(): void
        + cadastrarComSenhaAutomatica(String nome, String email): Map<String, Object>
        + atualizarPerfil(int id, String nome, String novaSenha, String fotoB64): Map<String, Object>
        + redefinirSenhaPorEmail(String email, String novaSenhaPlana): boolean
        + listarTodosComGrupos(): List<Map<String, Object>>
        + sincronizarGruposUsuario(int idUsr, List<Integer> idsGrupos): void
        + alternarStatus(int idUsr, int novoStatus): void
    }
    class SegurancaLogin {
        + {static} estaBloqueado(int idUsuario): boolean
        + {static} registrarFalha(int idUsuario): boolean
        + {static} registrarSucesso(int idUsuario): void
        + {static} desbloquear(int idUsuario): void
    }
    class Auditoria {
        + {static} registrar(Integer idUsuario, String acao, String entidade, Object id, Integer idPaciente, String detalhes, String ip): void
        + {static} registrar(Connection conn, ...): void
    }
    class Profissional {
        + porUsuario(int idUsuario): Map<String, Object>
        + listar(String termo, String tipo, boolean inativos): List<Map>
        + porId(int id): Map<String, Object>
        + criar(Map dados, int idUsuario): Resultado
        + atualizar(int id, Map dados, int idUsuario): Resultado
        + definirAtivo(int id, boolean ativo, int idUsuario): String
        + salvarDisponibilidade(int idMedico, List<Map> faixas, int idUsuario): Map<String, String>
    }
    class Especialidade {
        + listar(): List<Map>
        + ativas(): List<Map>
        + salvar(int id, Map dados, int idUsuario, long[] idGerado): Map<String, String>
        + definirAtivo(int id, boolean ativo): String
    }
    class Paciente {
        + buscar(String termo, boolean inativos, int pagina, int porPagina): Pagina
        + criar(Map dados, int idUsuario): Resultado
        + atualizar(int id, Map dados, int idUsuario): Resultado
        + definirAtivo(int id, boolean ativo, int idUsuario): void
        + historicoAdministrativo(int idPaciente): List<Map>
    }
    class Agenda {
        + horarios(int idMedico, LocalDate dia): List<Horario>
        + agendar(int pac, int med, int esp, LocalDateTime quando, int usr): Resultado
        + remarcar(int idConsulta, int med, LocalDateTime quando, String motivo, int usr): Resultado
        + registrarChegada(int idConsulta, int usr): Resultado
        + cancelar(int idConsulta, String motivo, int usr): Resultado
        - {static} reservar(Connection c, ...): Resultado
    }
    class AgendaExames {
        + horarios(int idTipoExame, LocalDate dia): List<Horario>
        + agendar(int pac, int tipo, LocalDateTime quando, Integer idSolicitacao, int usr): Resultado
        + cancelar(int id, String motivo, int usr): Resultado
        + registrarSituacao(int id, String situacao, int usr): Resultado
    }
    class Triagem {
        + fila(): List<Map>
