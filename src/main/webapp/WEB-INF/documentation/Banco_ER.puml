@startuml Banco_ER
title Banco "hospital" - Modelo Lógico (script.sql, Fase 3)

hide circle
hide empty members
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package "Acesso (framework)" #F1F5F9 {
  entity usuarios {
    * id_usuario <<PK>>
    --
    * nome
    * email <<UQ>>
    * senha_hash
    foto
    * status
    * primeiro_acesso
    * criado_em / atualizado_em
  }
  entity usuarios_seguranca {
    * id_usuario <<PK,FK>>
    --
    * falhas_consecutivas
    bloqueado_ate
    ultima_falha_em
    ultimo_login_em
  }
  entity grupos {
    * id_grupo <<PK>>
    --
    * nome <<UQ>>
    descricao
    * is_admin
  }
  entity permissoes {
    * id_permissao <<PK>>
    --
    * codigo <<UQ>>
    descricao
  }
  entity usuarios_grupos {
    * id_usuario <<PK,FK>>
    * id_grupo <<PK,FK>>
  }
  entity grupos_permissoes {
    * id_grupo <<PK,FK>>
    * id_permissao <<PK,FK>>
  }
  entity recuperacoes_senha {
    * id_recuperacao <<PK>>
    --
    * id_usuario <<FK>>
    * token_hash <<UQ>>
    * expira_em
    usado_em
  }
}

package "Exemplos do framework" #FAFAFA {
  entity arquivos_upload {
    * id_arquivo <<PK>>
    --
    * hash <<UQ>>
    * id_dono <<FK>>
    ...
  }
  entity chamados {
    * id_chamado <<PK>>
    --
    * id_usuario <<FK>>
    ...
  }
}

package "Cadastros" #EEF6FF {
  entity pacientes {
    * id_paciente <<PK>>
    --
    * nome
    * cpf <<UQ>>
    * data_nascimento
    sexo, telefone, email
    endereço (cep ... uf)
    contato de emergência
    * ativo
    criado_por / atualizado_por <<FK>>
  }
  entity paciente_alergias {
    * id_alergia <<PK>>
    --
    * id_paciente <<FK>>
    * substancia
    reacao, gravidade
    * ativo
  }
  entity profissionais {
    * id_profissional <<PK>>
    --
    id_usuario <<FK,UQ>>
    * tipo (medico|enfermeiro|funcionario)
    * nome
    cargo, email, telefone
    * ativo
  }
  entity medicos {
    * id_profissional <<PK,FK>>
    --
    * crm + crm_uf <<UQ>>
    * duracao_consulta_min
  }
  entity enfermeiros {
    * id_profissional <<PK,FK>>
    --
    * coren + coren_uf <<UQ>>
  }
  entity especialidades {
    * id_especialidade <<PK>>
    --
    * nome <<UQ>>
    * ativo
  }
  entity medico_especialidades {
    * id_profissional <<PK,FK>>
    * id_especialidade <<PK,FK>>
  }
  entity disponibilidades_medico {
    * id_disponibilidade <<PK>>
    --
    * id_profissional <<FK>>
    * dia_semana (1-7)
    * hora_inicio / hora_fim
  }
  entity classificacoes_prioridade {
    * id_classificacao <<PK>>
    --
    * codigo <<UQ>> (vermelho..azul)
    * cor_hex, ordem <<UQ>>
    * tempo_alvo_min
  }
}

package "Atendimento" #FFF9EB {
  entity consultas {
    * id_consulta <<PK>>
    --
    * id_paciente / id_medico / id_especialidade <<FK>>
    * data_hora, duracao_min
    * tipo (agendada|encaixe)
    * status
    slot_ativo (gerada)
    chegada_em, inicio/fim_atendimento_em
    cancelada_em/por, motivo_cancelamento
    remarcada_de <<FK,UQ>>
    --
    UQ (id_medico, data_hora, slot_ativo)
    UQ (id_paciente, data_hora, slot_ativo)
  }
  entity triagens {
    * id_triagem <<PK>>
    --
    * id_consulta <<FK>>
    * id_enfermeiro <<FK>>
    sinais vitais (CHECK de faixa)
    * queixa_principal
    sintomas, observacoes
    * id_classificacao <<FK>>
    retifica_id <<FK,UQ>>
    motivo_retificacao
  }
  entity prontuarios {
    * id_prontuario <<PK>>
    --
    * id_consulta <<FK,UQ>>
    * id_medico <<FK>>
    anamnese, hipóteses, conduta
    * status (rascunho|finalizado)
    * versao
    finalizado_em
  }
  entity prontuario_versoes {
    * id_versao <<PK>>
    --
    * id_prontuario + versao <<UQ>>
    * conteudo (JSON)
    alterado_por <<FK>>
  }
  entity evolucoes_clinicas {
    * id_evolucao <<PK>>
    --
    * id_prontuario <<FK>>
    * id_autor <<FK>>
    * tipo (evolucao|adendo)
    * texto
  }
  entity receitas {
    * id_receita <<PK>>
    --
    * id_consulta / id_medico <<FK>>
    orientacoes_gerais
    * status (emitida|cancelada)
  }
  entity receita_itens {
    * id_item <<PK>>
    --
    * id_receita + ordem <<UQ>>
    * medicamento, dosagem
    via, * frequencia, * duracao
  }
  entity exames {
    * id_exame <<PK>>
    --
    * id_consulta / id_medico <<FK>>
    * nome_exame, codigo
    justificativa
    * status (solicitado|cancelado)
  }
}

package "Rastreabilidade" #F4FBF7 {
  entity auditoria {
    * id_auditoria <<PK>>
    --
    id_usuario (sem FK)
    * acao
    entidade / id_entidade
    id_paciente
    ip, registrado_em
  }
  entity notificacoes {
    * id_notificacao <<PK>>
    --
    * tipo, canal, destinatario
    id_consulta / id_usuario <<FK>>
    * status
    erro
  }
}

usuarios ||--o| usuarios_seguranca
usuarios ||--o{ usuarios_grupos
grupos ||--o{ usuarios_grupos
grupos ||--o{ grupos_permissoes
permissoes ||--o{ grupos_permissoes
usuarios ||--o{ recuperacoes_senha
usuarios ||--o{ arquivos_upload
usuarios ||--o{ chamados

usuarios |o--o| profissionais
profissionais ||--o| medicos
profissionais ||--o| enfermeiros
medicos ||--o{ medico_especialidades
especialidades ||--o{ medico_especialidades
medicos ||--o{ disponibilidades_medico
pacientes ||--o{ paciente_alergias

pacientes ||--o{ consultas
medicos ||--o{ consultas
especialidades ||--o{ consultas
consultas |o--o| consultas : remarcada_de

consultas ||--o{ triagens
enfermeiros ||--o{ triagens
classificacoes_prioridade ||--o{ triagens
triagens |o--o| triagens : retifica

consultas ||--o| prontuarios
medicos ||--o{ prontuarios
prontuarios ||--o{ prontuario_versoes
prontuarios ||--o{ evolucoes_clinicas
profissionais ||--o{ evolucoes_clinicas

consultas ||--o{ receitas
medicos ||--o{ receitas
receitas ||--|{ receita_itens
consultas ||--o{ exames
medicos ||--o{ exames

consultas |o--o{ notificacoes
usuarios |o--o{ notificacoes

note bottom of auditoria
  Triggers: auditoria, triagens e evoluções não aceitam
  UPDATE/DELETE; prontuário finalizado é imutável;
  receita emitida só pode ser cancelada.
end note
@enduml
