@startuml Router
title ZTF_J2EE - Diagrama de Atividades do Router (Fase 4)

start

:Filtros em todas as requisições:\nSecurityHeadersFilter (CSP, X-Frame-Options, no-store)\nSessaoFilter (recarrega grupos/permissões se a ACL mudou);
:Tomcat direciona ao @WebServlet (Controller.service)\nou à JSP (que chama Router.checkJspAccess no topo);
:Router.normalizeUri(request) remove o contextPath e extrai o verbo HTTP;
:Rotas vêm do cache de routes.json\n(recarregado se o arquivo mudar, fora de produção);

:DatabaseProvisioner.checkAndProvision()\n(script.sql base + migrações pendentes);

if (URI existe no routes.json?) then (não)
  :404 (JSP ou JSON);
  stop
endif

if (Método HTTP existe para a rota?) then (não)
  if (Método == OPTIONS?) then (sim)
    :Preflight 204: cabeçalhos CORS só se a\nconfiguração permitir a origem;
    stop
  else (não)
    :405;
    stop
  endif
endif

:CORS: devolve UMA origem permitida (ou nada);

if (POST/PUT/PATCH/DELETE e rota sem "csrf": false?) then (sim)
  if (Token X-CSRF-Token / _csrf confere com a sessão?) then (não)
    :403 ERR_CSRF;
    stop
  endif
endif

if (session.required == true?) then (sim)
  if (Usuário na sessão com as chaves exigidas?) then (não)
    :401 (401.jsp ou JSON);
    stop
  endif
  if (primeiro_acesso == 1 e rota sem "allowFirstAccess"?) then (sim)
    if (Requisição AJAX?) then (sim)
      :403 ERR_PASSWORD_CHANGE_REQUIRED;
    else (não)
      :Redireciona para /trocar-senha;
    endif
    stop
  endif
endif

if (Usuário na sessão?) then (sim)
  if (É admin e a rota NÃO é strictGroup?) then (não)
    if (Rota restringe "users"/"groups"/"permissions" e o usuário não atende?) then (sim)
      :403 (Forbidden User/Group/Permission);
      stop
    endif
  endif
endif

if (Tipo de destino?) then (path)
  :RequestDispatcher.forward() para a JSP;
elseif (controller) then
  :controller.handle(action, req, res);
elseif (query) then
  :PreparedStatement com parâmetros da requisição;
  :JsonResponse;
elseif (dbquery) then
  :DBQuery.select();
  :JsonResponse;
endif

if (Exceção na execução?) then (sim)
  :Log com código de rastreio;\n500 genérico "Erro interno (código xxxx)";
endif
stop

@enduml
