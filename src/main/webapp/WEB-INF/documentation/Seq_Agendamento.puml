@startuml Seq_Agendamento
title Sequência de Agendamento de Consulta (o de exame segue o mesmo desenho)

actor "Recepcionista" as User
participant "agenda_form.jsp\n+ hospital.js" as View
participant "Router" as Router
participant "AgendaController" as Ctrl
participant "Agenda\n(Model)" as Model
database "MySQL" as DB
participant "Notificacao" as Notif
participant "mail.Mail" as Mail

User -> View : busca paciente (nome ou CPF)
View -> Router : GET /api/pacientes/busca?q=
Router -> Router : sessão + permissão pacientes.view
Router --> View : até 8 pacientes ativos (CPF mascarado)

User -> View : escolhe especialidade
View -> Ctrl : GET /api/agenda/medicos?especialidade=
Ctrl -> Model : medicosDaEspecialidade()
User -> View : escolhe médico e data
View -> Ctrl : GET /api/agenda/horarios?medico=&data=
Ctrl -> Model : horarios(medico, dia)
Model -> DB : disponibilidades_medico do dia da semana\n+ consultas com slot_ativo = 1
Model --> View : grade na duração da consulta\n(ocupados e passados desabilitados)

User -> View : escolhe horário e confirma
View -> Router : POST /api/consultas (X-CSRF-Token)
Router -> Router : CSRF, sessão, permissão consultas.agendar
Router -> Ctrl : agendar()
Ctrl -> Model : agendar(paciente, médico, especialidade, dataHora, usuário)
Model -> DB : BEGIN (conexão exclusiva)
Model -> DB : SELECT médico ... FOR UPDATE (trava a agenda do médico)
Model -> DB : paciente ativo? especialidade do médico?\ndentro da disponibilidade e alinhado à grade?
Model -> DB : sobreposição do médico ou do paciente?
alt horário livre
    Model -> DB : INSERT consultas (+ auditoria na mesma transação)
    Model -> DB : COMMIT
    Model --> Ctrl : ok (id)
    Ctrl -> Notif : consultaAgendada(...)
    Notif -> Mail : e-mail sem dado clínico\n(data, hora, médico, especialidade)
    Notif -> DB : INSERT notificacoes (enviada / simulada / falhou)
    Ctrl --> View : 200 "Consulta agendada" → agenda do dia
else conflito, fora da agenda ou inativo
    Model -> DB : ROLLBACK
    Ctrl --> View : 409 com o motivo
else outra pessoa gravou o mesmo horário no mesmo instante
    DB --> Model : UNIQUE (id_medico, data_hora, slot_ativo) viola
    Model -> DB : ROLLBACK
    Ctrl --> View : 409 "acabou de ser reservado"
end
@enduml
