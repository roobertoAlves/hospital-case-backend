<%@ page pageEncoding="UTF-8" %>
<%--
  Linha do dia: uma linha por medico, eixo de horas, o horario de atendimento como faixa
  clara e cada consulta como barra na sua hora real. O elemento proprio deste produto.
  Antes do include, a pagina define:
      List<Map<String, Object>> ldMedicos   (id_profissional, nome, inicio, fim, especialidades)
      List<Map<String, Object>> ldConsultas (id_medico, minuto_do_dia, duracao_min, status, hora, paciente)
      boolean ldEhHoje                      (desenha a linha de "agora")
--%>
<% if (ldMedicos.isEmpty()) { %>
    <p class="hc-empty">Nenhum médico atende neste dia.</p>
<% } else {
       int ldIni = 24 * 60, ldFim = 0;
       for (Map<String, Object> m : ldMedicos) {
           ldIni = Math.min(ldIni, utils.Rotulos.minutosDoDia(m.get("inicio")));
           ldFim = Math.max(ldFim, utils.Rotulos.minutosDoDia(m.get("fim")));
       }
       ldIni = (ldIni / 60) * 60;
       ldFim = ((ldFim + 59) / 60) * 60;
       double ldTotal = ldFim - ldIni;
       int ldAgora = models.Agenda.agora().getHour() * 60 + models.Agenda.agora().getMinute(); %>
<div class="hc-day" style="--hours: <%= (ldFim - ldIni) / 60 %>">
    <div class="hc-day-scale"><span></span><div class="hc-day-ticks">
    <% for (int h = ldIni; h <= ldFim; h += 60) { %><span style="left: <%= utils.Rotulos.pct((h - ldIni) / ldTotal * 100) %>"><%= String.format("%02d", h / 60) %>h</span><% } %>
    </div></div>
    <% for (Map<String, Object> m : ldMedicos) {
           int idM = ((Number) m.get("id_profissional")).intValue();
           int mi = utils.Rotulos.minutosDoDia(m.get("inicio")), mf = utils.Rotulos.minutosDoDia(m.get("fim")); %>
    <div class="hc-day-row">
        <div class="hc-day-who"><%= utils.Sanitize.escapeHtml(m.get("nome")) %><small><%= utils.Rotulos.ou(m.get("especialidades")) %></small></div>
        <div class="hc-day-track">
            <% for (int h = ldIni + 60; h < ldFim; h += 60) { %><span class="hc-day-hour" style="left: <%= utils.Rotulos.pct((h - ldIni) / ldTotal * 100) %>" aria-hidden="true"></span><% } %>
            <span class="hc-day-free" style="left: <%= utils.Rotulos.pct((mi - ldIni) / ldTotal * 100) %>; width: <%= utils.Rotulos.pct((mf - mi) / ldTotal * 100) %>" aria-hidden="true"></span>
            <% for (Map<String, Object> c : ldConsultas) {
                   if (((Number) c.get("id_medico")).intValue() != idM || "cancelada".equals(c.get("status"))) { continue; }
                   int cm = ((Number) c.get("minuto_do_dia")).intValue();
                   int dur = ((Number) c.get("duracao_min")).intValue();
                   String st = String.valueOf(c.get("status"));
                   String cls = "realizada".equals(st) || "ausente".equals(st) ? " is-done" : ("agendada".equals(st) ? "" : " is-here"); %>
            <span class="hc-day-bar<%= cls %>" style="left: <%= utils.Rotulos.pct((cm - ldIni) / ldTotal * 100) %>; width: <%= utils.Rotulos.pct(dur / ldTotal * 100) %>"
                  title="<%= utils.Sanitize.escapeHtml(c.get("hora") + " · " + c.get("paciente")) %>"
                  aria-label="<%= utils.Sanitize.escapeHtml(c.get("hora") + " " + c.get("paciente")) %>"><%= utils.Sanitize.escapeHtml(utils.Menu.iniciais(String.valueOf(c.get("paciente")))) %></span>
            <% } %>
            <% if (ldEhHoje && ldAgora >= ldIni && ldAgora <= ldFim) { %><span class="hc-day-now" style="left: <%= utils.Rotulos.pct((ldAgora - ldIni) / ldTotal * 100) %>" aria-hidden="true"></span><% } %>
        </div>
    </div>
    <% } %>
    <div class="hc-legend mt-3">
        <span><i style="background: var(--accent-soft); border-left: 3px solid var(--accent)"></i>Agendada</span>
        <span><i style="background: var(--accent)"></i>Paciente na unidade</span>
        <span><i style="background: var(--raised); border-left: 3px solid #8a9094"></i>Concluída ou falta</span>
        <span><i style="background: #f6f8f9; border: 1px solid var(--border)"></i>Horário de atendimento</span>
        <% if (ldEhHoje) { %><span><i style="background: var(--negative); width: 2px"></i>Agora</span><% } %>
    </div>
</div>
<% } %>
