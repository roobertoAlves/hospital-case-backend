<?xml version="1.0" encoding="UTF-8"?>
<!--
  Build Maven minimo do projeto (decisao D1).
  - Nao move pastas: src/main/java e src/main/webapp ja seguem o layout Maven/WAR.
  - As bibliotecas continuam em src/main/webapp/WEB-INF/lib (fonte unica). Aqui elas sao
    referenciadas com scope "system" apenas para compilar e testar; o WAR as leva porque
    fazem parte do diretorio webapp.
  - Eclipse (m2e) e IntelliJ IDEA importam este mesmo arquivo.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>hospital</groupId>
    <artifactId>hospital-case-manager</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>war</packaging>
    <name>Sistema Integrado de Gestao Clinica e Hospitalar (ZTF_J2EE)</name>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <webinf.lib>${project.basedir}/src/main/webapp/WEB-INF/lib</webinf.lib>
        <junit.version>5.10.5</junit.version>
    </properties>

    <dependencies>
        <!-- Fornecido pelo Tomcat (8.5 = Servlet 3.1; Tomcat 9 tambem e compativel). -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>3.1.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- Bibliotecas ja versionadas em WEB-INF/lib. -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
            <scope>system</scope>
            <systemPath>${webinf.lib}/gson-2.10.1.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.4.0</version>
            <scope>system</scope>
            <systemPath>${webinf.lib}/mysql-connector-j-8.4.0.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.sun.mail</groupId>
            <artifactId>jakarta.mail</artifactId>
            <version>1.6.7</version>
            <scope>system</scope>
            <systemPath>${webinf.lib}/jakarta.mail-1.6.7.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.sun.activation</groupId>
            <artifactId>jakarta.activation</artifactId>
            <version>1.2.2</version>
            <scope>system</scope>
            <systemPath>${webinf.lib}/jakarta.activation-1.2.2.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.4</version>
            <scope>system</scope>
            <systemPath>${webinf.lib}/postgresql-42.7.4.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
            <version>23.5.0.24.07</version>
            <scope>system</scope>
            <systemPath>${webinf.lib}/ojdbc11-23.5.0.24.07.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.ibm.db2</groupId>
            <artifactId>jcc</artifactId>
            <version>11.5.9.0</version>
            <scope>system</scope>
            <systemPath>${webinf.lib}/jcc-11.5.9.0.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.47.0.0</version>
            <scope>system</scope>
            <systemPath>${webinf.lib}/sqlite-jdbc-3.47.0.0.jar</systemPath>
        </dependency>

        <!-- Testes (decisao D3): JUnit 5, fora do WAR. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>hospital-case-manager</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <compilerArgs>
                        <arg>-Xlint:all,-path</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <argLine>-Dfile.encoding=UTF-8</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
                <configuration>
                    <!-- Configuracao local e dados gerados nao vao para o pacote. -->
                    <packagingExcludes>WEB-INF/etc/config.local.json,WEB-INF/storage/logs/*.log,WEB-INF/storage/uploads/**</packagingExcludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
