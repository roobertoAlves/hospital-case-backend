src/main/webapp/WEB-INF/storage/uploads/*

# Sistema operacional
Thumbs.db
.DS_Store

# Configuracao local de cada maquina (senhas, pepper, SMTP)
src/main/webapp/WEB-INF/etc/config.local.json

# Arquivos de assistentes de IA, memoria e automacao local (nao fazem parte do projeto)
.claude/
.claude-mem/
CLAUDE.md
CLAUDE.local.md
AGENTS.md
GEMINI.md
.cursor/
.aider*
.codex/
.kiro/
