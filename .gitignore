# Build output (CLI, Eclipse, IntelliJ)
build/
bin/
out/
target/
*.class
*.war

# IDE files (per-machine settings)
.idea/workspace.xml
.idea/shelf/
*.iws
.metadata/
.recommenders/

# Runtime data (may contain temporary passwords / personal data)
src/main/webapp/WEB-INF/storage/logs/*.log
src/main/webapp/WEB-INF/storage/uploads/*
src/main/webapp/WEB-INF/storage/pedidos/*

# Operating system
Thumbs.db
.DS_Store

# Per-machine local configuration (passwords, pepper, SMTP)
src/main/webapp/WEB-INF/etc/config.local.json

# AI assistant, memory and local automation files (not part of the project)
.claude/
.claude-mem/
CLAUDE.md
CLAUDE.local.md
AGENTS.md
GEMINI.md
.cursor/
.aider*
.codex/
.kiro/
.headroom/
*.agent.md

